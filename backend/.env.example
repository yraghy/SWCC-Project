# Server
PORT=4000
NODE_ENV=development

# Auth bypass for local dev — set to "true" to skip Cognito JWT verification
# and accept a fake user from the X-Dev-User header (JSON-encoded AuthClaims).
# Must be "false" in production.
AUTH_DEV_BYPASS=true

# AWS
AWS_REGION=eu-central-1

# Cognito (manual setup — see docs/CLOUD_SETUP.md)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# DynamoDB tables (manual setup)
DDB_USERS_TABLE=swcc-project-users
DDB_TEAMS_TABLE=swcc-project-teams
DDB_PROJECTS_TABLE=swcc-project-projects
DDB_TASKS_TABLE=swcc-project-tasks
DDB_COMMENTS_TABLE=swcc-project-comments
DDB_AUDIT_TABLE=swcc-project-audit

# DynamoDB GSIs on tasks
DDB_TASKS_GSI_TEAM=byTeam
DDB_TASKS_GSI_ASSIGNEE=byAssignee
DDB_TASKS_GSI_DEADLINE=byDeadline

# S3 buckets (manual setup)
S3_ORIGINALS_BUCKET=swcc-project-originals
S3_RESIZED_BUCKET=swcc-project-resized

# SNS / SQS / CloudWatch
SNS_ASSIGNMENT_TOPIC_ARN=
SNS_DIGEST_TOPIC_ARN=
CW_NAMESPACE=SWCCProject
